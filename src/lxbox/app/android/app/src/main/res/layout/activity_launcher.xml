<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main launcher panel: градиент в цветах иконки (тёмный графит). -->
    <LinearLayout
        android:id="@+id/launcher_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_launcher_gradient"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btn_drawer_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#00000000"
                android:contentDescription="@string/menu_toggle_desc"
                android:padding="12dp"
                android:tint="@color/launcher_cream"
                android:src="@drawable/ic_drawer_hamburger" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <!-- Кнопка строго по центру, чуть выше визуальной середины; статус/бренд не двигают её. -->
            <com.leadaxe.lxbox.ConnectRingButton
                android:id="@+id/btn_connect_all"
                android:layout_width="184dp"
                android:layout_height="184dp"
                android:layout_centerInParent="true"
                android:translationY="-32dp"
                android:clickable="true"
                android:contentDescription="@string/launcher_btn_connect"
                android:focusable="true" />

            <TextView
                android:id="@+id/launcher_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@id/btn_connect_all"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="34dp"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:text="@string/app_launcher_label"
                android:textColor="@color/launcher_cream"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/launcher_connect_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/btn_connect_all"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:textColor="@color/launcher_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Доп. инфо (вачдог/трафик): не двигает центр, появляется снизу. -->
            <LinearLayout
                android:id="@+id/launcher_info_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="26dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/launcher_watchdog_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/launcher_muted"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/launcher_watchdog_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/launcher_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/launcher_traffic_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:letterSpacing="0.03"
                    android:textColor="@color/launcher_gold_hi"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- Drawer -->
    <LinearLayout
        android:id="@+id/launcher_drawer"
        android:layout_width="272dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/launcher_bg_bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:letterSpacing="0.08"
            android:text="@string/app_launcher_label"
            android:textColor="@color/launcher_cream"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/drawer_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/menu_about"
            android:textColor="@color/launcher_cream"
            android:textSize="16sp" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>