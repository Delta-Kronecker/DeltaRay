<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1220"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">

    <TextView
        android:id="@+id/launcher_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/app_chooser_title"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/launcher_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="@string/app_chooser_subtitle"
        android:textColor="#8A93A6"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btn_connect_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:minHeight="72dp"
        android:backgroundTint="#5B4FB8"
        android:text="@string/app_chooser_connect_all"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/launcher_desc_connect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="@string/app_chooser_connect_hint"
        android:textColor="#8A93A6"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btn_open_lxbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:minHeight="72dp"
        android:backgroundTint="#1C6E5C"
        android:text="@string/launcher_open_lxbox"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/launcher_desc_lxbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="@string/launcher_desc_lxbox"
        android:textColor="#8A93A6"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btn_open_zerodpi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:minHeight="72dp"
        android:backgroundTint="#8A3A3A"
        android:text="@string/launcher_open_zerodpi"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/launcher_desc_zerodpi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="@string/launcher_desc_zerodpi"
        android:textColor="#8A93A6"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/launcher_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/launcher_footer"
        android:textColor="#5A6274"
        android:textSize="12sp" />

</LinearLayout>